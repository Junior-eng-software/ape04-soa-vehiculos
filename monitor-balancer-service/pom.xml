<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Misma versión de Spring Boot que venta-vehiculos-api_security -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>ec.edu.uta</groupId>
	<artifactId>monitor-balancer-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>monitor-balancer-service</name>
	<description>APE 04 - Web API independiente que observa NGINX y las instancias de vehiculos: salud, latencias, distribucion real del balanceo, estadisticas y alertas</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<!-- Web API REST (Spring MVC + Tomcat + Jackson). Sin base de datos: todo en memoria. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
