# Configuración local de XAMPP (no publicar un .env real)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=venta_vehiculos
DB_USER=COLOCA_USUARIO_DB
DB_PASSWORD=COLOCA_PASSWORD_DB

# URL de la API Spring Boot
JAVA_URL=http://127.0.0.1:8080

# Copia exactamente el valor de app.security.ventas-key de Java
VENTAS_SERVICE_KEY=COLOCA_CLAVE_VENTAS_DE_AL_MENOS_32_CARACTERES

# Receptor Spring Boot de notificaciones
NOTIFICACIONES_URL=http://127.0.0.1:8081
# Igual a app.notificacion-key en el receptor de avisos,
# y a servicios.notificaciones.key en el emisor Java
NOTIFICACIONES_KEY=COLOCA_CLAVE_NOTIFICACIONES_DE_AL_MENOS_32_CARACTERES
